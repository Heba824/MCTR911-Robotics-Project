<mujoco model="UR5e surgical handover workstation - MCTR911 Milestone 02">
  <!--
    Based on the team's original scene.xml. Keep this scene in the same directory
    as ur5e.xml so MuJoCo can resolve the robot's mesh assets correctly.

    CRITICAL KINEMATICS CHOICE:
      The included UR5e base remains at (0, 0, 0), with unchanged joints.
      Instead, the FLOOR is moved down to z=-0.65 m and a pedestal table is
      placed directly below the original base. DH/FK/IK world coordinates and
      the existing attachment_site are consequently unchanged.

    All workstation props are fixed and visual-only in Milestone 02; no tool
    grasping, hand tracking or collision-avoidance functionality is implied.
  -->
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.22 0.22 0.22" specular="0.05 0.05 0.05"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="125" elevation="-22"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.36 0.48 0.6" rgb2="0.12 0.16 0.22"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.37 0.42 0.46" rgb2="0.28 0.32 0.36" markrgb="0.67 0.68 0.68"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.08"/>
    <material name="table_steel" rgba="0.76 0.81 0.84 1" specular="0.6" shininess="0.45"/>
    <material name="table_frame" rgba="0.20 0.26 0.31 1" specular="0.35" shininess="0.3"/>
    <material name="tray_metal" rgba="0.64 0.70 0.74 1" specular="0.65" shininess="0.5"/>
  </asset>

  <worldbody>
    <light name="workstation_light" pos="0.25 -0.35 2.0" dir="-0.1 0 -1" directional="true"/>

    <!-- Floor is 0.65 m below UR5e base; its change does not alter UR5e FK. -->
    <geom name="operating_room_floor" type="plane" pos="0 0 -0.65" size="0 0 0.05"
          material="groundplane"/>

    <!-- ROBOT-MOUNTING TABLE: tabletop upper surface is exactly z=0. -->
    <body name="robot_support_table">
      <geom name="robot_tabletop" type="box" pos="0 0 -0.025" size="0.34 0.36 0.025"
            material="table_steel" contype="0" conaffinity="0"/>
      <geom name="robot_table_frame" type="box" pos="0 0 -0.085" size="0.31 0.33 0.035"
            material="table_frame" contype="0" conaffinity="0"/>
      <geom name="robot_leg_front_left" type="box" pos="0.28 -0.29 -0.375"
            size="0.027 0.027 0.275" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="robot_leg_front_right" type="box" pos="0.28 0.29 -0.375"
            size="0.027 0.027 0.275" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="robot_leg_back_left" type="box" pos="-0.28 -0.29 -0.375"
            size="0.027 0.027 0.275" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="robot_leg_back_right" type="box" pos="-0.28 0.29 -0.375"
            size="0.027 0.027 0.275" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="robot_lower_shelf" type="box" pos="0 0 -0.57" size="0.31 0.33 0.013"
            material="table_frame" contype="0" conaffinity="0"/>
    </body>

    <!-- Separate instrument table. Its upper surface is at z=+0.08 m. -->
    <body name="instrument_table" pos="0.75 -0.20 0.05">
      <geom name="instrument_tabletop" type="box" size="0.22 0.24 0.03"
            material="table_steel" contype="0" conaffinity="0"/>
      <geom name="instrument_leg_1" type="cylinder" pos="0.17 0.19 -0.365"
            size="0.016 0.335" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="instrument_leg_2" type="cylinder" pos="-0.17 0.19 -0.365"
            size="0.016 0.335" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="instrument_leg_3" type="cylinder" pos="0.17 -0.19 -0.365"
            size="0.016 0.335" material="table_frame" contype="0" conaffinity="0"/>
      <geom name="instrument_leg_4" type="cylinder" pos="-0.17 -0.19 -0.365"
            size="0.016 0.335" material="table_frame" contype="0" conaffinity="0"/>
    </body>

    <!-- Shallow fixed tray, placed on the instrument table surface (z=0.08). -->
    <body name="instrument_tray" pos="0.75 -0.20 0.08">
      <geom name="tray_base" type="box" pos="0 0 0.006" size="0.155 0.19 0.006"
            material="tray_metal" contype="0" conaffinity="0"/>
      <geom name="tray_x_wall_positive" type="box" pos="0.155 0 0.020"
            size="0.004 0.194 0.014" material="tray_metal" contype="0" conaffinity="0"/>
      <geom name="tray_x_wall_negative" type="box" pos="-0.155 0 0.020"
            size="0.004 0.194 0.014" material="tray_metal" contype="0" conaffinity="0"/>
      <geom name="tray_y_wall_positive" type="box" pos="0 0.19 0.020"
            size="0.155 0.004 0.014" material="tray_metal" contype="0" conaffinity="0"/>
      <geom name="tray_y_wall_negative" type="box" pos="0 -0.19 0.020"
            size="0.155 0.004 0.014" material="tray_metal" contype="0" conaffinity="0"/>
    </body>

    <!-- Two SIMPLIFIED STATIC surgical instrument placeholders (not yet graspable). -->
    <!-- Scalpel center at (0.75, -0.13, 0.099) m: handle along global +X. -->
    <body name="scalpel" pos="0.75 -0.13 0.099">
      <geom name="scalpel_handle" type="capsule" size="0.006 0.050" euler="0 1.57079632679 0"
            rgba="0.30 0.37 0.42 1" contype="0" conaffinity="0"/>
      <geom name="scalpel_blade" type="box" pos="0.077 0 0" size="0.025 0.009 0.002"
            rgba="0.85 0.89 0.91 1" contype="0" conaffinity="0"/>
      <site name="scalpel_pickup_site" type="sphere" pos="0 0 0.03" size="0.009"
            rgba="0.98 0.7 0.12 0.8"/>
    </body>

    <!-- A simplified pair of forceps, oriented along the global +X axis. -->
    <body name="forceps" pos="0.75 -0.29 0.099">
      <geom name="forceps_upper" type="capsule" fromto="-0.065 0.008 0 0.07 0.016 0"
            size="0.004" rgba="0.75 0.79 0.82 1" contype="0" conaffinity="0"/>
      <geom name="forceps_lower" type="capsule" fromto="-0.065 -0.008 0 0.07 -0.016 0"
            size="0.004" rgba="0.75 0.79 0.82 1" contype="0" conaffinity="0"/>
      <geom name="forceps_hinge" type="sphere" pos="-0.01 0 0" size="0.008"
            rgba="0.45 0.5 0.55 1" contype="0" conaffinity="0"/>
      <site name="forceps_pickup_site" type="sphere" pos="0 0 0.03" size="0.009"
            rgba="0.98 0.7 0.12 0.8"/>
    </body>

    <!-- Static symbolic surgeon's hand and cyan end-effector handover marker. -->
    <!-- Target position: (0.30, 0.43, 0.38) m in the unchanged MuJoCo world frame. -->
    <body name="surgeon_handover_target" pos="0.30 0.43 0.38">
      <geom name="surgeon_glove_palm" type="ellipsoid" pos="0 0.085 0" size="0.038 0.055 0.020"
            rgba="0.18 0.50 0.70 0.85" contype="0" conaffinity="0"/>
      <geom name="surgeon_glove_wrist" type="capsule" fromto="0 0.12 0 0 0.23 0" size="0.030"
            rgba="0.16 0.44 0.66 0.85" contype="0" conaffinity="0"/>
      <site name="handover_target_site" type="sphere" size="0.027" rgba="0.0 0.95 0.95 0.60"/>
    </body>
  </worldbody>
</mujoco>
